PORT=3001
NODE_ENV=development
JWT_SECRET=change_this_to_a_secure_random_string
FRONTEND_URL=http://localhost:5173

# Optional: SMTP configuration for real emails
# If not set, emails will be sent via Ethereal (test account, check console for preview URL)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password

# Optional: Dashboard URL for team notification emails
# DASHBOARD_URL=http://your-domain.com/admin

# ─── SharePoint Integration (Microsoft Graph API) ─────────────────────────────
# Enables automatic sync of submissions to SharePoint + document upload.
# Leave blank to disable (submissions still work normally without it).
#
# Step 1 — Register an Azure AD app:
#   portal.azure.com > Azure Active Directory > App registrations > New registration
#   Add API permission: Microsoft Graph > Application > Sites.ReadWrite.All
#   Grant admin consent, then create a Client Secret.
#
# Step 2 — Create SharePoint list "Supplier Compliance Submissions" with columns:
#   CompanyName, ContactName, ContactEmail, Country, SubmissionDate (Date),
#   Status (Choice), RegulatoryCompliant (Choice), RegulatoryPenalties (Yes/No),
#   PenaltyDetails, KosherCertExpiry (Date), KosherCertBody, KosherCertNA (Yes/No),
#   HalalCertExpiry (Date), HalalCertBody, HalalCertNA (Yes/No),
#   NSFCertExpiry (Date), NSFCertDetails, Products, SignatoryName, SignatoryTitle
#
# Step 3 — Get IDs via Graph Explorer (https://developer.microsoft.com/graph/graph-explorer):
#   Site ID:  GET /v1.0/sites/{tenant}.sharepoint.com:/{site-path}
#   List ID:  GET /v1.0/sites/{siteId}/lists   (find "Supplier Compliance Submissions")
#   Drive ID: GET /v1.0/sites/{siteId}/drives  (find "Supplier Compliance Documents" library)
#
# Step 4 — Power Automate expiry notification flow:
#   Trigger: Recurrence (Daily)
#   Action: Get items from SharePoint list
#     Filter query (repeat for each expiry column):
#       KosherCertExpiry le '@{addDays(utcNow(), 60)}' and KosherCertNA eq 0
#   Action: Send email listing expiring certificates
#
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-app-client-id
# AZURE_CLIENT_SECRET=your-client-secret
# SHAREPOINT_SITE_ID=your-sharepoint-site-id
# SHAREPOINT_LIST_ID=your-list-id
# SHAREPOINT_DRIVE_ID=your-document-library-drive-id  (optional — for file uploads)
