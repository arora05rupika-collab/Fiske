PORT=3001
NODE_ENV=development
JWT_SECRET=change_this_to_a_secure_random_string
FRONTEND_URL=http://localhost:5173

# Optional: SMTP configuration for real emails
# If not set, emails will be sent via Ethereal (test account, check console for preview URL)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password

# Optional: Dashboard URL for team notification emails
# DASHBOARD_URL=http://your-domain.com/admin
